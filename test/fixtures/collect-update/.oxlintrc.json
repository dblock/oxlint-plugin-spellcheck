{
  // Preserve this comment.
  "plugins": [],
  "jsPlugins": [
    {
      "name": "spellcheck",
      "specifier": "@dblock/oxlint-plugin-spellcheck"
    }
  ],
  "rules": {
    "spellcheck/check": [
      "error",
      {
        "comments": true,
        "dictionaries": ["@dictionary-en", "./words.txt"]
      }
    ]
  }
}
