{
  "plugins": [],
  "jsPlugins": [
    {
      "name": "spellcheck",
      "specifier": "oxlint-plugin-spellcheck"
    }
  ],
  "rules": {
    "spellcheck/check": [
      "error",
      {
        "dictionaries": [
          "@dictionary-en",
          "@spellcheck/dictionary-fixture"
        ]
      }
    ]
  }
}
